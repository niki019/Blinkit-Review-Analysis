# Database configuration
DATABASE_URL=sqlite:///reviews.db

# n8n Webhook Ingestion URL
N8N_WEBHOOK_URL=https://nikiagape.app.n8n.cloud/workflow/h7hGpQhZBPsHDy58

# Groq LLM API Configuration (Used for summarization and verification)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Unsupervised Topic Embedding Configuration
# Provider options: local, openai, gemini
EMBEDDING_PROVIDER=local
# Model name for local SentenceTransformer (e.g., BAAI/bge-small-en-v1.5 for English-heavy or BAAI/bge-m3 for robust multilingual/Hinglish search)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
